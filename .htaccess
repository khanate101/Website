Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Keep application source, database scripts, dependencies and configuration private.
RewriteRule ^(?:app|bin|config|database|storage|tests|vendor)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.env(?:$|/) - [F,L,NC]
RewriteRule (^|/)\.git(?:$|/) - [F,L,NC]

# The public directory is the only web entry point.
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(?:\.env|composer\.(?:json|lock)|README\.md)$">
  Require all denied
</FilesMatch>
